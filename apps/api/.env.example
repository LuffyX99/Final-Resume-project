# ===========================================
# API - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.

# --- Database Connection ---
# For local development (DB running via docker compose from root):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resume_matching

# --- OpenAI ---
# Required for embeddings (text-embedding-ada-002)
# and skill extraction / PII stripping (gpt-4o-mini).
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# --- Authentication ---
# Sign tokens with a random value, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Admin fixed credentials (not stored in user tables) ---
ADMIN_ID=admin
ADMIN_EMAIL=admin.resumematch@gmail.com
ADMIN_PASSWORD=Admin#ResumeMatch2026
ADMIN_FULL_NAME=Platform Admin

# --- Email OTP Verification ---
REQUIRE_EMAIL_OTP=false
OTP_EXPIRY_MINUTES=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# --- SMTP Configuration ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_EMAIL=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=noreply@resumematch.ai
# SMTP_USE_TLS=true

# --- Uploads ---
# Maximum accepted resume upload in bytes (default 5 MiB).
MAX_RESUME_BYTES=5242880
